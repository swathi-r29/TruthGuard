# LLM Provider configuration (gemini or ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama local configuration (optional fallback)
OLLAMA_MODEL=gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434

# Path to Tesseract OCR executable (Only needed on Windows if not in System PATH)
# Example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# UI Settings
CURRENCY_SYMBOL=₹

# Logging and debugging
DEBUG=true
