# TruthGuard Configuration

# LLM Provider: 'gemini', 'groq', or 'ollama'
LLM_PROVIDER=gemini

# Google Gemini Flash configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq configuration (Fast Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama configuration (Local, 100% Free & Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Tesseract OCR executable path (Windows optional, e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Debugging
DEBUG=true
